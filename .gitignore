*.log

# Temp / swap files
*.swp
*~

# devtest seri köprü günlüğü
scripts/devtest/wbridge.log
__pycache__/

# Galeri görsel paketi (üretilir: scripts/gen_gallery_pack.py)
build_assets/

# release.py çıktıları (büyük tam imajlar)
release/

